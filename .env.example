# Copy to .env and fill required values:
#   cp .env.example .env
#
# Generate MASTER_ENCRYPTION_KEY (32 bytes, base64):
#   openssl rand -base64 32
#
# Generate INTERNAL_PIPELINE_TOKEN (opaque secret):
#   openssl rand -hex 32

# Required — same value used by the pipeline service (workspace api_keys encryption at rest)
MASTER_ENCRYPTION_KEY=

# Required — shared secret between Next.js and FastAPI (header X-Zkast-Internal-Token)
INTERNAL_PIPELINE_TOKEN=

# Database / cache / graph — defaults below target published Compose ports on localhost (hybrid: DB in Docker, `pnpm dev`).
# Services started by Compose still get internal URLs via docker-compose.yml `environment` (postgres/redis/falkordb hostnames).
DATABASE_URL=postgresql://zkast:zkast@127.0.0.1:5432/zkast
REDIS_URL=redis://127.0.0.1:6379/0
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380

# Pipeline: embedding vector width for Graphiti (must match FalkorDB indexes; 1536 matches embed-v4.0 default)
# EMBEDDING_DIM=1536

# Graphiti: max concurrent LLM/embed/rerank operations (Cohere-friendly; raise 16–20 on higher quotas)
# SEMAPHORE_LIMIT=10

# Web → pipeline — use localhost when Next runs on the host; Compose overrides to http://pipeline:8000 for the web container.
PIPELINE_INTERNAL_URL=http://127.0.0.1:8000

# P0 single-user bypass (must match seeded user in migrations)
BYPASS_USER_ID=00000000-0000-4000-8000-000000000001
DEFAULT_WORKSPACE_SLUG=default

# Telemetry off by default (self-hosted)
ZKAST_OTEL_ENABLED=false
GRAPHITI_TELEMETRY_ENABLED=false

# PDF ingestion (Sprint 3): shared volume mount for pipeline + worker
ZKAST_STORAGE_ROOT=/var/zkast/storage
MAX_UPLOAD_BYTES=52428800

# Optional Sprint 2+
# COHERE_API_KEY=
