# Copy to .env and fill required values:
#   cp .env.example .env
#
# Generate MASTER_ENCRYPTION_KEY (32 bytes, base64):
#   openssl rand -base64 32
#
# Generate INTERNAL_PIPELINE_TOKEN (opaque secret):
#   openssl rand -hex 32

# Required — encryption at rest for API keys (Sprint 2+); validated in pipeline tests
MASTER_ENCRYPTION_KEY=

# Required — shared secret between Next.js and FastAPI (header X-Zkast-Internal-Token)
INTERNAL_PIPELINE_TOKEN=

# Database / cache / graph (Docker Compose defaults). Alembic maps postgresql:// → psycopg v3 automatically.
DATABASE_URL=postgresql://zkast:zkast@postgres:5432/zkast
REDIS_URL=redis://redis:6379/0
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# Web → pipeline (inside Docker network)
PIPELINE_INTERNAL_URL=http://pipeline:8000

# P0 single-user bypass (must match seeded user in migrations)
BYPASS_USER_ID=00000000-0000-4000-8000-000000000001
DEFAULT_WORKSPACE_SLUG=default

# Telemetry off by default (self-hosted)
ZKAST_OTEL_ENABLED=false
GRAPHITI_TELEMETRY_ENABLED=false

# Optional Sprint 2+
# COHERE_API_KEY=
